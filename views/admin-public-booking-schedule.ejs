<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Public Booking Schedule Settings - RehabPlus</title>

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Libraries -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css" rel="stylesheet">

    <!-- Design System -->
    <link href="/public/css/variables.css" rel="stylesheet">
    <link href="/public/css/base.css" rel="stylesheet">
    <link href="/public/css/accessibility.css" rel="stylesheet">

    <style>
        .time-slot-btn {
            width: 100%;
            margin-bottom: 0.5rem;
        }
        .day-card {
            border: 2px solid #e9ecef;
            transition: all 0.3s;
        }
        .day-card.active {
            border-color: #0d6efd;
            background-color: #f8f9ff;
        }
        .day-card.inactive {
            opacity: 0.6;
            background-color: #f5f5f5;
        }
        .event-card {
            border-left: 4px solid #0d6efd;
        }
        .event-card.published {
            border-left-color: #198754;
        }
        .event-card.full {
            border-left-color: #ffc107;
        }
        .event-card.cancelled {
            border-left-color: #dc3545;
        }
    </style>
</head>
<body>
    <%- include('partials/header') %>

    <!-- Skip to main content -->
    <a href="#main-content" class="skip-link d-none">Skip to main content</a>

    <!-- Mobile navbar toggle -->
    <nav class="navbar navbar-dark bg-dark d-md-none">
        <div class="container-fluid">
            <span class="navbar-brand font-weight-bold">Public Booking Schedule</span>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#sidebarMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <%- include('partials/sidebar', { user, activePage: 'booking-schedule' }) %>

            <!-- Main Content -->
            <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
                <div class="container-fluid py-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h2><i class="bi bi-calendar-week"></i> Public Booking Schedule Settings</h2>
                        <div>
                            <span class="text-muted">Logged in as: <%= user.first_name %> <%= user.last_name %></span>
                            <a href="/logout" class="btn btn-outline-danger btn-sm ms-3">
                                <i class="bi bi-box-arrow-right"></i> Logout
                            </a>
                        </div>
                    </div>

                    <!-- Tabs -->
                    <ul class="nav nav-tabs mb-4" id="settingsTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="working-hours-tab" data-bs-toggle="tab" data-bs-target="#working-hours" type="button">
                                <i class="bi bi-clock"></i> Working Hours
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="special-hours-tab" data-bs-toggle="tab" data-bs-target="#special-hours" type="button">
                                <i class="bi bi-calendar-plus"></i> Special Days
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="closed-dates-tab" data-bs-toggle="tab" data-bs-target="#closed-dates" type="button">
                                <i class="bi bi-calendar-x"></i> Closed Dates
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="events-tab" data-bs-toggle="tab" data-bs-target="#events" type="button">
                                <i class="bi bi-calendar-event"></i> Events
                            </button>
                        </li>
                    </ul>

                    <!-- Tab Content -->
                    <div class="tab-content" id="settingsTabContent">
                        <!-- Working Hours Tab -->
                        <div class="tab-pane fade show active" id="working-hours" role="tabpanel">
                            <div class="card">
                                <div class="card-header">
                                    <h5><i class="bi bi-clock-history"></i> Configure Working Hours</h5>
                                    <p class="mb-0 text-muted">Set which days and hours the clinic accepts public bookings</p>
                                </div>
                                <div class="card-body">
                                    <div id="working-hours-list" class="row g-3">
                                        <!-- Working hours will load here -->
                                    </div>
                                    <div class="mt-3">
                                        <button class="btn btn-success" onclick="saveWorkingHours()">
                                            <i class="bi bi-save"></i> Save Working Hours
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Special Opening Hours Tab -->
                        <div class="tab-pane fade" id="special-hours" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h4>Special Opening Days</h4>
                                    <p class="text-muted mb-0">Override default schedule for specific dates (e.g., open on Sunday, extended hours)</p>
                                </div>
                                <button class="btn btn-primary" onclick="showSpecialHoursModal()">
                                    <i class="bi bi-plus-circle"></i> Add Special Day
                                </button>
                            </div>
                            <div id="special-hours-list">
                                <!-- Special hours will load here -->
                            </div>
                        </div>

                        <!-- Closed Dates Tab -->
                        <div class="tab-pane fade" id="closed-dates" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4>Closed Dates & Holidays</h4>
                                <button class="btn btn-primary" onclick="showClosedDateModal()">
                                    <i class="bi bi-plus-circle"></i> Add Closed Date
                                </button>
                            </div>
                            <div id="closed-dates-list">
                                <!-- Closed dates will load here -->
                            </div>
                        </div>

                        <!-- Events Tab -->
                        <div class="tab-pane fade" id="events" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h4>Special Events</h4>
                                <button class="btn btn-primary" onclick="showEventModal()">
                                    <i class="bi bi-plus-circle"></i> Create Event
                                </button>
                            </div>
                            <div id="events-list">
                                <!-- Events will load here -->
                            </div>
                        </div>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Closed Date Modal -->
    <div class="modal fade" id="closedDateModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Closed Date</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="closedDateForm">
                        <input type="hidden" id="closed_date_id">

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="is_date_range" onchange="toggleDateRange()">
                            <label class="form-check-label" for="is_date_range">
                                <strong>Close multiple days (date range)</strong>
                            </label>
                        </div>

                        <div id="single-date-container">
                            <div class="mb-3">
                                <label class="form-label">Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="closed_date">
                            </div>
                        </div>

                        <div id="date-range-container" style="display: none;">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Start Date <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" id="closed_start_date">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">End Date <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control" id="closed_end_date">
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Reason <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="closed_reason" placeholder="e.g., New Year Holiday, Summer Vacation, Staff Training" required>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="is_recurring">
                            <label class="form-check-label" for="is_recurring">
                                Recurring yearly (e.g., public holidays)
                            </label>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveClosedDate()">Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Event Modal -->
    <div class="modal fade" id="eventModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Special Event</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="eventForm">
                        <input type="hidden" id="event_id">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Event Date <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="event_date" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">Start Time <span class="text-danger">*</span></label>
                                <input type="time" class="form-control" id="event_start_time" required>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">End Time <span class="text-danger">*</span></label>
                                <input type="time" class="form-control" id="event_end_time" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Event Name <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" id="event_name" placeholder="e.g., Free Health Screening Day" required>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" id="event_description" rows="3" placeholder="Describe the event..."></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label">Event Image</label>
                                <input type="file" class="form-control" id="event_image_file" accept="image/*">
                                <input type="hidden" id="event_image_path">
                                <div id="event_image_preview" class="mt-2" style="display: none;">
                                    <img id="preview_img" src="" alt="Event preview" style="max-width: 100%; max-height: 200px; border-radius: 8px;">
                                    <button type="button" class="btn btn-sm btn-danger mt-2" onclick="removeEventImage()">
                                        <i class="bi bi-trash"></i> Remove Image
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Max Participants</label>
                                <input type="number" class="form-control" id="max_participants" placeholder="Leave blank for unlimited">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Status <span class="text-danger">*</span></label>
                                <select class="form-select" id="event_status" required>
                                    <option value="DRAFT">Draft (not visible)</option>
                                    <option value="PUBLISHED">Published (visible on booking page)</option>
                                    <option value="FULL">Full (no more registrations)</option>
                                    <option value="CANCELLED">Cancelled</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="is_public" checked>
                                    <label class="form-check-label" for="is_public">
                                        Show on public booking page
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="registration_required" checked>
                                    <label class="form-check-label" for="registration_required">
                                        Require registration to attend
                                    </label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveEvent()">Save Event</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Special Hours Modal -->
    <div class="modal fade" id="specialHoursModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Special Opening Day</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="specialHoursForm">
                        <input type="hidden" id="special_hours_id">

                        <div class="mb-3">
                            <label class="form-label">Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="special_date" required>
                            <small class="text-muted">This will override the default schedule for this specific date</small>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" id="is_open" checked onchange="toggleSpecialHours()">
                            <label class="form-check-label" for="is_open">
                                <strong>Open on this day</strong>
                            </label>
                            <small class="text-muted d-block">Uncheck to close on this day</small>
                        </div>

                        <div id="special-hours-time-container">
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <label class="form-label">Opening Time <span class="text-danger">*</span></label>
                                    <input type="time" class="form-control" id="special_start_time" value="08:00">
                                    <small class="text-muted">Can be earlier than normal hours</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Closing Time <span class="text-danger">*</span></label>
                                    <input type="time" class="form-control" id="special_end_time" value="23:00">
                                    <small class="text-muted">Can be later than normal hours</small>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Reason</label>
                            <input type="text" class="form-control" id="special_reason" placeholder="e.g., Special Sunday Opening, Extended Hours 08:00-23:00">
                            <small class="text-muted">Optional description</small>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" onclick="saveSpecialHours()">Save</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Event Registrations Modal -->
    <div class="modal fade" id="eventRegistrationsModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Event Registrations</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="event-registrations-list">
                        <!-- Registrations will load here -->
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>
    <script src="/public/js/admin-public-booking-schedule.js"></script>
</body>
</html>
